# Clean reference for the tracked .env. The repository's .env contains the
# verified current-machine profile; use this file when replacing those values
# with portable defaults. Video2Mesh, GroundingDINO and sam2 are assumed to be
# sibling repositories, models live in ./models, runs live in ./runs, and the
# Conda environments are named svpp/groundingdino/sam2.

# CG_WORKSPACE_ROOT=/absolute/path/containing/all-four-repositories
# CG_MODEL_ROOT=/absolute/path/to/model-root
# CG_OUTPUT_BASE=/absolute/path/to/video2mesh-runs
# CG_DEPENDENCY_ROOT=/absolute/path/to/bootstrap-cache
# CG_CONDA_ROOT=/absolute/path/to/miniconda3
# CG_CONDA_ENVS_ROOT=/absolute/path/to/miniconda3/envs

# Optional compatibility packages used by older serialized ConceptGraphs maps.
# CG_DEPS=/absolute/path/to/conceptgraphs-python-packages

# OpenAI-compatible Responses API. Keep the API key out of this file; the
# scene-graph script requests it with hidden input or reads OPENAI_API_KEY_FILE.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# OPENAI_VISION_MODEL=
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=0

# Only needed when reading an old map whose color_path values contain a stale
# absolute mount prefix. New runs do not need these variables.
# MAP_PATH_REMAP_FROM=/old/mount/prefix
# MAP_PATH_REMAP_TO=/new/mount/prefix
